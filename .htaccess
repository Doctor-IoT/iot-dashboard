# iot-dashboard/.htaccess
# Protegge file sensibili per estensione, ma NON blocca public/
# La protezione di php/ e db/ è affidata ai loro .htaccess locali

# Blocca file sensibili ovunque sotto iot-dashboard/
<FilesMatch "\.(sqlite|sql|log|env|bak|sh|py|ini|cfg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# No directory listing
Options -Indexes
